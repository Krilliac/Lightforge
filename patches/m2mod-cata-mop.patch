+// ---- TXIDChunk ----
+
+void M2Chunk::TXIDChunk::Load(std::fstream& FileStream, UInt32 Size)
+{
+	assert(Size % sizeof(UInt32) == 0);
+	UInt32 count = Size / sizeof(UInt32);
+	TextureFileDataIds.resize(count);
+	FileStream.read((char*)TextureFileDataIds.data(), Size);
+}
+
+void M2Chunk::TXIDChunk::Save(std::fstream& FileStream)
+{
+	FileStream.write((char*)TextureFileDataIds.data(), TextureFileDataIds.size() * sizeof(UInt32));
+}
