diff --git a/core/chunks/MCNK.cpp b/core/chunks/MCNK.cpp
index 0000000..1111111 100644
--- a/core/chunks/MCNK.cpp
+++ b/core/chunks/MCNK.cpp
@@ -32,7 +32,15 @@ MCNK::MCNK(std::fstream& adtFile, MCIN* mcin_) :
         if (entries[i].header.ofsMCSE)
             entries[i].mcse = std::make_unique<MCSE>(adtFile, MCNKChunk_Start + entries[i].header.ofsMCSE);
-        if (entries[i].header.ofsMCCV)
+
+        // MCCV (vertex shading) was added in WotLK.  In Vanilla/TBC ADTs,
+        // the field at offset 0x74 in the MCNK header was "textureId" and
+        // may contain a non-zero value that is NOT an MCCV offset.  The
+        // FLAG_MCCV (0x40) flag in the MCNK header reliably indicates
+        // whether the chunk actually contains MCCV data.  Checking both
+        // the flag and the offset prevents a false read on Vanilla ADTs
+        // where textureId happened to be non-zero.
+        if ((entries[i].header.flags & FLAG_MCCV) && entries[i].header.ofsMCCV)
             entries[i].mccv = std::make_unique<MCCV>(adtFile, MCNKChunk_Start + entries[i].header.ofsMCCV);

         adtFile.seekg(MCNKChunk_Start + sizeof(ChunkHeader) + mcin->entries[i].size); //get ready for next entry
