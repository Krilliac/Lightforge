+        /// <summary>
+        /// Validates that an ADT file has MVER version 18 (pre-Cataclysm).
+        /// Returns true if valid or if MVER cannot be found (best-effort).
+        /// Logs a warning for non-18 versions but does not block processing,
+        /// since the chunk-scanning approach may still extract usable data.
+        /// </summary>
+        static bool ValidateAdtVersion(string path)
+        {
+            try
+            {
+                using (var fileStream = new FileStream(path, FileMode.Open, FileAccess.Read))
+                {
+                    if (fileStream.Length < 8)
+                    {
+                        Log($" [WARNING] File too small to be a valid ADT: {path}");
+                        return false;
+                    }
+                    using (var binReader = new BinaryReader(fileStream))
+                    {
+                        // MVER chunk: 4 bytes magic "REVM" (reversed) + 4 bytes size + 4 bytes version
+                        uint magic = binReader.ReadUInt32();
+                        // 0x5245564D = "REVM" in little-endian = "MVER"
+                        if (magic != 0x5245564D)
+                        {
+                            Log($" [WARNING] File does not start with MVER chunk: {path}");
+                            return true; // best-effort: still try to parse
+                        }
+                        uint size = binReader.ReadUInt32();
+                        uint version = binReader.ReadUInt32();
+                        if (version != 18)
+                        {
+                            Log($" [WARNING] ADT version is {version}, expected 18 (pre-Cataclysm). Parsing may not work correctly: {path}");
+                        }
+                        return true;
+                    }
+                }
+            }
+            catch (Exception) { return true; }
+        }
